<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs s&box's own AccessControl (API whitelist) verifier on a compiled game assembly. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <SboxManaged Condition="'$(SboxManaged)' == ''">$(SBOX_MANAGED)</SboxManaged>
  </PropertyGroup>
  <ItemGroup><Reference Include="$(SboxManaged)/*.dll" /></ItemGroup>
</Project>
